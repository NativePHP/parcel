#!/usr/bin/env php
<?php

declare(strict_types=1);

// Find the autoloader
$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',  // Local installation
    __DIR__ . '/../../../autoload.php',   // Global installation via composer
];

$autoloaderFound = false;
foreach ($autoloadPaths as $autoloadPath) {
    if (file_exists($autoloadPath)) {
        require_once $autoloadPath;
        $autoloaderFound = true;
        break;
    }
}

if (!$autoloaderFound) {
    fwrite(STDERR, "Error: Could not find Composer autoloader.\n");
    fwrite(STDERR, "Please run 'composer install' or install Parcel via Composer.\n");
    exit(1);
}

use Parcel\Application;

// Create and run the application
try {
    $application = new Application();
    $application->run();
} catch (Exception $e) {
    fwrite(STDERR, "Error: " . $e->getMessage() . "\n");
    exit(1);
}