{
    "name": "parcel/parcel",
    "description": "Laravel PHAR bundler for NativePHP applications",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "phar",
        "laravel",
        "nativephp",
        "bundler"
    ],
    "authors": [
        {
            "name": "Eser DENIZ",
            "email": "srwiez@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "humbug/box": "^4.0",
        "symfony/console": "^6.4|^7.0",
        "symfony/filesystem": "^6.4|^7.0",
        "symfony/process": "^6.4|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Parcel\\": "src/"
        }
    },
    "bin": [
        "bin/parcel"
    ],
    "config": {
        "sort-packages": true
    }
}
