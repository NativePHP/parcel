{
  "name": "nativephp/parcel",
  "description": "Laravel PHAR bundler for NativePHP applications with cross-platform path handling and optimization features",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/NativePHP/parcel",
  "keywords": [
    "phar",
    "laravel",
    "nativephp",
    "bundler",
    "packaging"
  ],
  "authors": [
    {
      "name": "Simon Hamp",
      "email": "simon.hamp@me.com"
    },
    {
      "name": "Eser DENIZ",
      "email": "srwiez@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "composer-runtime-api": "^2.0",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-phar": "*",
    "humbug/box": "^4.7.1",
    "symfony/console": "^6.4|^7.0",
    "symfony/filesystem": "^6.4|^7.0",
    "symfony/process": "^6.4|^7.0"
  },
  "require-dev": {
    "laravel/pint": "^1.22",
    "pestphp/pest": "^2.36",
    "phpstan/phpstan": "^2.1"
  },
  "suggest": {
    "ext-zlib": "For compressed PHAR files",
    "ext-bz2": "For bzip2 compressed PHAR files"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Parcel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/parcel"
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "pestphp/pest-plugin": true
    }
  },
  "support": {
    "issues": "https://github.com/NativePHP/parcel/issues",
    "source": "https://github.com/NativePHP/parcel"
  },
  "scripts": {
    "test": "pest --parallel",
    "pint": "pint --parallel",
    "phpstan": "phpstan analyse",
    "static": [
      "@pint",
      "@phpstan"
    ],
    "qa": [
      "@pint",
      "@phpstan",
      "@test"
    ]
  }
}
